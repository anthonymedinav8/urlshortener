# Database
DB_NAME=urlshortener
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Public base URL used to build short_url responses
BASE_URL=http://localhost:5001

# Optional: when set, /shorten requires header `X-API-Key: <value>`
API_KEY=

# Rate limits (Flask-Limiter syntax)
RATE_LIMIT_SHORTEN=20 per minute
RATE_LIMIT_REDIRECT=120 per minute
RATE_LIMIT_ENABLED=true

FLASK_DEBUG=false
